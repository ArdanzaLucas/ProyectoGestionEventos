ot></mxGraphModel></diagram><diagram id="b" name="Base de datos"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1880" pageHeight="1271" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="b1" value="Base de datos SQLite (Data/presupuestos.db)" style="rounded=1;arcSize=1;absoluteArcSize=1;dashed=1;dashPattern=8 4;fillColor=#f5f9fe;strokeColor=#6c8ebf;fontColor=#6c8ebf;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;html=1;" vertex="1" parent="1"><mxGeometry x="100" y="70" width="1170" height="1121" as="geometry"/></mxCell><mxCell id="b2" value="PK = clave primaria, FK = clave foranea.&lt;br&gt;Las tablas se crean al arrancar si no existen (SqliteDatabase).&lt;br&gt;Los precios se guardan como TEXT y se leen como decimal.&lt;br&gt;QUOTE, DETAIL_MENU y DETAIL_OPTION_ITEM guardan una copia&lt;br&gt;de los nombres y precios: el presupuesto no cambia si despues&lt;br&gt;se edita el evento, la ubicacion, el menu o el servicio.&lt;br&gt;MENU_MENU_TAG es la tabla intermedia de menus y etiquetas." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1330" y="140" width="470" height="121" as="geometry"/></mxCell><mxCell id="b3" value="EVENT_ITEM" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;collapsible=0;fontSize=12;container=1;" vertex="1" parent="1"><mxGeometry x="160" y="180" width="170" height="139" as="geometry"/></mxCell><mxCell id="b4" value="&lt;div style=&quot;line-height:15px&quot;&gt;PK&amp;nbsp;&amp;nbsp;Id INTEGER&lt;br&gt;Name TEXT&lt;br&gt;ClientName TEXT&lt;br&gt;Date TEXT&lt;br&gt;GuestAdults INTEGER&lt;br&gt;GuestChildren INTEGER&lt;br&gt;Duration INTEGER&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;whiteSpace=nowrap;overflow=visible;rotatable=0;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="b3"><mxGeometry y="26" width="170" height="113" as="geometry"/></mxCell><mxCell id="b5" value="QUOTE" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;collapsible=0;fontSize=12;container=1;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="190" height="274" as="geometry"/></mxCell><mxCell id="b6" value="&lt;div style=&quot;line-height:15px&quot;&gt;PK&amp;nbsp;&amp;nbsp;Id INTEGER&lt;br&gt;FK&amp;nbsp;&amp;nbsp;EventItemId INTEGER&lt;br&gt;EventName TEXT&lt;br&gt;EventClientName TEXT&lt;br&gt;EventDate TEXT&lt;br&gt;EventGuestAdults INTEGER&lt;br&gt;EventGuestChildren INTEGER&lt;br&gt;EventDuration INTEGER&lt;br&gt;FK&amp;nbsp;&amp;nbsp;LocationId INTEGER&lt;br&gt;LocationName TEXT&lt;br&gt;LocationPrice TEXT&lt;br&gt;State INTEGER&lt;br&gt;TotalLocation TEXT&lt;br&gt;TotalMenus TEXT&lt;br&gt;TotalOptionItems TEXT&lt;br&gt;Total TEXT&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;whiteSpace=nowrap;overflow=visible;rotatable=0;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="b5"><mxGeometry y="26" width="190" height="248" as="geometry"/></mxCell><mxCell id="b7" value="LOCATION" style="swimlane;fontStyle=1;html=1;whiteSpace=wrap;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;collapsible=0;fontSize=12;container=1;" vertex="1" parent="1"><mxGeometry x="980" y="180" width="170" height="94" as="geometry"/></mxCell><mxCell id="b8" value="&lt;div style=&quot;line-height:15px&quot;&gt;PK&amp;nbsp;&amp;nbsp;Id INTEGER&lt;br&gt;Name TEXT&lt;br&gt;Price TEXT&lt;br&gt;IsActive INTEGER&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=1;whiteSpace=nowrap;overflow=visible;rotatable=0;fontSize=11;fontFamily=Helvetica;" vertex=