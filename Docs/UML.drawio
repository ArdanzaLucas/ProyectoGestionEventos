          <mxGeometry x="100" y="70" width="1160" height="1121" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="PK = clave primaria, FK = clave foranea.&lt;br&gt;Las tablas se crean al arrancar si no existen (SqliteDatabase).&lt;br&gt;Los precios se guardan como TEXT y se leen como decimal.&lt;br&gt;QUOTE, DETAIL_MENU y DETAIL_OPTION_ITEM guardan una copia&lt;br&gt;de los nombres y precios: el presupuesto no cambia si despues&lt;br&gt;se edita el evento, la ubicacion, el menu o el servicio.&lt;br&gt;MENU_MENU_TAG es la tabla intermedia de menus y etiquetas." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=11;" vertex="1" parent="1">
